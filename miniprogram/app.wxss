/* app.wxss —— 全局基础样式 */
@import "./styles/tokens.wxss";

view,
text,
scroll-view {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: var(--sp-4);
}

/* 卡片 */
.card {
  background: var(--surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: var(--sp-4);
}

/* 标签(全圆角弱暖色) */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-tag);
  background: var(--surface-warm);
  color: var(--brand-orange);
  font-size: var(--fs-tag);
  font-weight: 500;
}

/* 通用状态区(loading/empty/error) */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--sp-4);
  color: var(--text-sub);
  font-size: var(--fs-aux);
  text-align: center;
}
.state__title {
  font-size: var(--fs-body);
  color: var(--text-main);
  margin-bottom: var(--sp-2);
}

/* 主按钮(次级用途此处也复用) */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  padding: 0 var(--sp-5);
  border-radius: var(--radius-btn);
  background: var(--brand-gradient);
  color: #fff;
  font-size: var(--fs-body);
  border: none;
}
.btn-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 var(--sp-5);
  border-radius: var(--radius-btn);
  background: var(--surface);
  color: var(--brand-orange);
  font-size: var(--fs-aux);
  border: 2rpx solid var(--surface-warm);
}
