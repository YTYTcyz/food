:host { display: block; }
.frame { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: inherit; }
.image, .placeholder { position: absolute; inset: 0; width: 100%; height: 100%; }
.placeholder { box-sizing: border-box; display: flex; align-items: center; justify-content: center; padding: 12rpx; color: #ac8a79; background: #f5e5dc; font-size: 22rpx; line-height: 1.5; text-align: center; }
