.order {
  padding: var(--sp-4);
  padding-bottom: 200rpx;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}
.order > .card { margin-bottom: var(--sp-4); }
.payment-options { display: flex; flex-wrap: wrap; gap: 24rpx; margin-top: 24rpx; }
.payment-options label { display: flex; align-items: center; }

.state {
  padding: 120rpx var(--sp-4);
  text-align: center;
  color: var(--text-sub);
}
.state__title {
  font-size: var(--fs-title);
  color: var(--text-main);
  margin-bottom: var(--sp-3);
}
.state__btn {
  margin-top: var(--sp-5);
  display: inline-block;
}

.order__merchant {
  font-size: var(--fs-title);
  font-weight: 600;
  color: var(--text-main);
}

.line {
  display: flex;
  align-items: center;
  gap: var(--sp-3);
  padding: var(--sp-3) 0;
  border-bottom: 2rpx solid var(--divider);
}
.line:last-child {
  border-bottom: none;
}
.line__img {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-md);
  background: var(--surface-warm);
  flex-shrink: 0;
}
.line__info {
  flex: 1;
  min-width: 0;
}
.line__name {
  font-size: var(--fs-body);
  color: var(--text-main);
}
.line__price {
  font-size: var(--fs-aux);
  color: var(--text-sub);
  margin-top: var(--sp-1);
}

.stepper {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: var(--sp-3);
}
.stepper__btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  background: var(--surface-warm);
  color: var(--brand-orange);
}
.stepper__btn--add {
  background: var(--brand-orange);
  color: #fff;
}
.stepper__qty {
  min-width: 40rpx;
  text-align: center;
  color: var(--text-main);
}

.fees__row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: space-between;
  font-size: var(--fs-aux);
  color: var(--text-sub);
  padding: var(--sp-2) 0;
}
.fees__row--total {
  border-top: 2rpx solid var(--divider);
  margin-top: var(--sp-2);
  padding-top: var(--sp-3);
  font-size: var(--fs-body);
  color: var(--text-main);
}
.fees__total {
  color: var(--brand-orange);
  font-weight: 600;
  font-size: var(--fs-title);
}
.fees__kcal {
  margin-top: var(--sp-3);
  font-size: var(--fs-aux);
  color: var(--brand-green);
}

.note__label {
  font-size: var(--fs-aux);
  color: var(--text-sub);
  margin-bottom: var(--sp-2);
}
.note__input {
  width: 100%;
  min-height: 120rpx;
  font-size: var(--fs-body);
  color: var(--text-main);
}

.sim-tip {
  margin: var(--sp-4) var(--sp-1);
  font-size: var(--fs-aux);
  color: var(--text-sub);
  line-height: 1.6;
}

.submit-bar {
  position: fixed;
  z-index: 100;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--sp-3) var(--sp-4);
  /* 逐级兜底 iPhone 底部安全区 */
  padding-bottom: var(--sp-3);
  padding-bottom: calc(var(--sp-3) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--sp-3) + env(safe-area-inset-bottom));
  background: var(--surface);
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.submit-bar__total { flex: 1; min-width: 0; }
.submit-bar__label {
  display: block;
  font-size: var(--fs-aux);
  color: var(--text-sub);
  margin-right: var(--sp-2);
}
.submit-bar__num {
  font-size: 44rpx;
  color: var(--brand-orange);
  font-weight: 600;
}
.submit-bar__btn {
  flex-shrink: 0;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 var(--sp-4);
  border-radius: 999rpx;
  background: var(--brand-gradient);
  color: #fff;
  font-size: var(--fs-body);
  margin: 0;
}
.submit-bar__btn[disabled] {
  opacity: 0.6;
}
