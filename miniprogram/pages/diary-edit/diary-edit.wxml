<view class="screen"><challenge-banner order-id="{{orderId}}" bind:leave="leave" /><view class="heading">{{existing ? '我的心情记录' : '写给此刻的自己'}}</view><view class="subtitle">无需写得漂亮，你的感受就值得记录。</view><view wx:if="{{hint}}" class="error-box">{{hint}}</view><view wx:if="{{status !== 'ready'}}" class="empty">{{status === 'error' ? '暂时无法打开，请返回后重试' : '正在打开…'}}</view><block wx:else><view class="moods"><view wx:for="{{moods}}" wx:key="*this" class="mood {{mood === item ? 'selected' : ''}}" data-mood="{{item}}" bindtap="mood">{{item}}</view></view><view class="section"><textarea disabled="{{saving}}" class="editor" value="{{body}}" maxlength="4000" placeholder="此刻发生了什么？你有什么感受？" bindinput="onInput" /><view class="muted counter">{{count}} / 2000</view></view><view wx:if="{{encouragement}}" class="encouragement"><view class="section-title">陪伴小语</view><text>{{encouragement}}</text></view><button class="action" loading="{{saving}}" disabled="{{saving || !body}}" bindtap="save">保存日记</button><view class="row stack"><button class="soft-button" bindtap="leave">返回</button><button wx:if="{{existing}}" class="soft-button" disabled="{{saving}}" bindtap="remove">删除记录</button></view><view class="muted stack">草稿仅保存在当前设备，保存后才计入日记。</view></block></view>


