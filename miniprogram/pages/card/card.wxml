<view class="screen"><challenge-banner order-id="{{orderId}}" bind:leave="leave" /><view class="heading">把微光拼成喜欢的模样</view><view class="subtitle">你做出的每一次选择，都在这里留下痕迹。</view><view wx:if="{{status === 'error'}}" class="error-box" bindtap="load">卡片暂时没有加载 · 重试</view><view wx:if="{{!card && status !== 'error'}}" class="section empty"><view>{{status === 'loading' ? '正在点亮微光…' : '第一次挑战成功后，自动开始你的第一张拼图。'}}</view><button wx:if="{{status === 'ready'}}" class="soft-button stack" bindtap="start">开始一次挑战</button></view><block wx:if="{{card}}"><view class="section"><view class="puzzle" style="{{frameStyle}}"><cloud-image class="picture" src="{{card.fileID}}" mode="aspectFit" placeholder="你的微光图片正在准备中" /><view class="tiles" style="{{gridStyle}}"><view wx:for="{{tiles}}" wx:key="index" class="tile {{item.hidden ? 'covered' : ''}}">{{item.hidden ? '✦' : ''}}</view></view></view><view class="row stack"><view class="section-title">{{card.status === 'completed' ? '这张拼图已集齐' : '已完成 ' + card.currentStep + '/7 次'}}</view><text class="muted">{{card.revealedTileIndexes.length}} / {{card.tileCount}} 块</text></view><view class="progress"><view class="progress-fill" style="width: {{card.currentStep / 7 * 100}}%"></view></view><view class="muted">同一天的每次成功，都能继续点亮。</view></view><view class="section" bindtap="weight"><view class="row"><text class="section-title">{{goal ? '目标体重 ' + target + ' kg' : '按自己的节奏，记录变化'}}</text><text class="link">记录 ›</text></view><view class="muted">当前体重 {{current}}{{current !== '未记录' ? ' kg' : ''}}</view><block wx:if="{{goal && goal.percent !== null}}"><view class="progress"><view class="progress-fill" style="width: {{goal.percent}}%"></view></view><view class="muted">阶段进度 {{goal.percent}}%</view></block></view><view wx:if="{{imageError}}" class="error-box" bindtap="retryImage">{{imageError}}</view><view wx:if="{{changing}}" class="muted stack">正在保存图片设置…</view><view class="quote">每一个小小的选择，都在为你积累力量。</view><block wx:if="{{card.status === 'active'}}"><view class="section"><view class="section-title">选择喜欢的图片</view><view class="muted">点图放大，左右滑动选图；★ 已集齐的图片仅供欣赏</view><view wx:if="{{presetError}}" class="muted" bindtap="load">图库加载失败 · 点击重试</view><view wx:elif="{{!presets.length}}" class="muted">图库暂时没有图片，可以上传一张喜欢的图片。</view><scroll-view wx:if="{{presets.length}}" class="preset-scroll" scroll-y="{{presets.length > 9}}" style="height: {{presets.length > 6 ? 534 : presets.length > 3 ? 352 : 170}}rpx;"><view class="presets"><view wx:for="{{presets}}" wx:key="key" class="preset" data-key="{{item.key}}" bindtap="change" aria-label="{{item.name + (item.completed ? '，已集齐，点击预览' : '，点击预览')}}">
  <cloud-image class="preset-image" src="{{item.fileID}}" mode="aspectFit" />
  <text wx:if="{{item.completed}}" class="preset-star" aria-label="已集齐">★</text>
  <text wx:if="{{item.sourceType === 'personal'}}" class="preset-personal">我的上传</text>
</view></view></scroll-view><view wx:if="{{presets.length > 9}}" class="muted preset-hint">上滑查看更多图片</view><button class="soft-button stack" disabled="{{changing}}" bindtap="upload">上传我的图片</button><view class="muted stack">换图保留成功次数；比例变化时按新网格分配亮块。完成后图片锁定。</view></view></block><button wx:else class="action" loading="{{changing}}" disabled="{{changing}}" bindtap="background">设为我的主页背景</button></block></view>


<view wx:if="{{previewPreset}}" class="preview-mask" catchtap="closePreview" catchtouchmove="keepPreview">
  <view class="preview-panel" catchtap="keepPreview" role="dialog" aria-label="浏览并选择拼图图片">
    <view class="preview-header">
      <view class="preview-heading">{{previewPreset.name || '图片预览'}}</view>
      <view class="muted">{{previewIndex + 1}} / {{presets.length}} · {{previewPreset.sourceType === 'personal' ? '我的上传' : '系统图片'}}</view>
    </view>
    <scroll-view class="preview-body" scroll-y>
      <view class="preview-picture" bindtouchstart="previewTouchStart" bindtouchend="previewTouchEnd" bindtouchcancel="previewTouchCancel">
        <cloud-image class="preview-image" src="{{previewPreset.fileID}}" mode="aspectFit" />
      </view>
      <view wx:if="{{previewPreset.completed}}" class="preview-achievement">★ 这张图片你已集齐{{previewPreset.completedCount || 1}}次</view>
    </scroll-view>
    <view class="preview-navigation">
      <button class="soft-button" bindtap="previousPreset" disabled="{{changing || previewIndex === 0}}">‹ 上一张</button>
      <button class="soft-button" bindtap="nextPreset" disabled="{{changing || previewIndex + 1 >= presets.length}}">下一张 ›</button>
    </view>
    <view class="preview-question">{{previewPreset.completed ? '已集齐，留作纪念' : '是否更换当前拼图图片？'}}</view>
    <view class="muted">{{previewPreset.completed ? '这张图片只能浏览，请滑动选择其他图片。' : '左右滑动选图，更换后成功次数会保留。'}}</view>
    <view class="preview-actions">
      <button class="soft-button" bindtap="closePreview">取消</button>
      <button class="action" bindtap="confirmPresetChange" disabled="{{changing || previewPreset.completed}}">{{previewPreset.completed ? '已集齐 · 不可选择' : '确认更换'}}</button>
    </view>
  </view>
</view>
