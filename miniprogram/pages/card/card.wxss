@import '../../styles/personal.wxss';
.puzzle { position: relative; max-width: 100%; margin: 0 auto; border-radius: 24rpx; overflow: hidden; background: #f5e5dc; }.picture, .picture-fallback, .tiles { position: absolute; inset: 0; width: 100%; height: 100%; }.picture-fallback { display: flex; align-items: center; justify-content: center; padding: 30rpx; font-size: 26rpx; color: #ac8a79; text-align: center; }.tiles { display: grid;  pointer-events: none; }.tile { min-width: 0; min-height: 0; overflow: hidden; border: 1rpx solid #ffffff55; }.covered { background: #f8d5b2; color: #de9b72; display: flex; align-items: center; justify-content: center; font-size: 30rpx; }.quote { padding: 28rpx; background: #fce4ec; color: #ad5d76; line-height: 1.8; border-radius: 28rpx; margin-bottom: 28rpx; }.presets { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12rpx; margin-top: 20rpx; }.preset { width: 100%; height: 170rpx; border-radius: 20rpx; }

