<view class="screen"><challenge-banner order-id="{{orderId}}" bind:leave="leave" /><view class="heading">心事日记</view><view class="subtitle">{{total}} 篇记录 · {{words}} 字心情</view><button class="action" bindtap="edit">写下此刻的心情</button><view class="error-box stack" wx:if="{{status === 'error'}}" bindtap="retry">日记未能加载 · 点击重试</view><view class="empty" wx:if="{{status === 'loading'}}">正在翻开日记…</view><view class="empty" wx:elif="{{!items.length && status === 'ready'}}">还没有记录。<view>从一句话开始也可以。</view></view><view class="section stack" wx:for="{{items}}" wx:key="_id" data-id="{{item._id}}" bindtap="edit"><view class="row"><text>{{item.mood || '心情记录'}}</text><text class="muted">{{item.time}}</text></view><view class="diary-preview">{{item.body}}</view></view><button wx:if="{{hasMore}}" class="soft-button" bindtap="more">查看更多</button></view>

