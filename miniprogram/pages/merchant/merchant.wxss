.merchant {
  padding-bottom: 184rpx;
  padding-bottom: calc(184rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(184rpx + env(safe-area-inset-bottom));
}

.m-header {
  margin-bottom: var(--sp-4);
}
.m-header__name {
  font-size: var(--fs-title);
  font-weight: 500;
  color: var(--text-main);
}
.m-header__comment {
  font-size: var(--fs-aux);
  color: var(--text-sub);
  margin-top: var(--sp-2);
}

.disclaimer {
  font-size: var(--fs-tag);
  color: var(--text-sub);
  margin: 0 var(--sp-1) var(--sp-4);
}

.menu-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-3);
}
.menu-item {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-3);
}
.menu-item__img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-btn);
  background: var(--surface-warm);
  flex-shrink: 0;
}
.menu-item__info {
  flex: 1;
  min-width: 0;
}
.menu-item__name {
  font-size: var(--fs-body);
  font-weight: 500;
  color: var(--text-main);
}
.menu-item__meta {
  margin-top: var(--sp-2);
}
.menu-item__bottom {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-2);
}
.menu-item__price {
  font-size: var(--fs-body);
  color: var(--text-main);
  font-weight: 500;
}

.stepper {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: var(--sp-3);
}
.stepper__btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
  background: var(--surface-warm);
  color: var(--brand-orange);
}
.stepper__btn--add {
  background: var(--brand-orange);
  color: #fff;
}
.stepper__qty {
  min-width: 40rpx;
  text-align: center;
  font-size: var(--fs-body);
  color: var(--text-main);
}

.cart-bar {
  position: fixed;
  z-index: 100;
  left: var(--sp-4);
  right: var(--sp-4);
  /* 逐级兜底:calc 内嵌 env 在部分基础库会整条失效,先给纯值 */
  bottom: var(--sp-4);
  bottom: calc(var(--sp-4) + constant(safe-area-inset-bottom));
  bottom: calc(var(--sp-4) + env(safe-area-inset-bottom));
  min-height: 96rpx;
  border-radius: 999rpx;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 12rpx 10rpx var(--sp-4);
  gap: 16rpx;
}
.cart-bar__info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  gap: 4rpx;
}
.cart-bar__count {
  font-size: var(--fs-body);
  color: var(--text-main);
  font-weight: 500;
}
.cart-bar__total {
  font-size: var(--fs-aux);
  color: var(--text-sub);
}
.cart-bar__btn {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 var(--sp-6);
  border-radius: 999rpx;
  background: var(--brand-gradient);
  color: #fff;
  font-size: var(--fs-body);
  display: flex;
  align-items: center;
}

.sim-note {
  text-align: center;
  font-size: var(--fs-tag);
  color: var(--text-sub);
  margin-top: var(--sp-6);
}
