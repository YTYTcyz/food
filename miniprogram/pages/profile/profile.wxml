<view class="screen"><view class="heading">个人资料</view><view class="subtitle">你可以按喜欢的样子，介绍自己。</view><view wx:if="{{status === 'error'}}" class="error-box" bindtap="load">资料加载失败 · 重试</view><view class="section"><view class="profile-avatar" bindtap="photo"><cloud-image class="avatar-image" wx:if="{{avatar}}" src="{{avatar}}" mode="aspectFill" /><text wx:else>我</text></view><view class="link center" bindtap="photo">更换头像</view><view class="stack">昵称</view><input disabled="{{saving || status !== 'ready'}}" class="field" value="{{nickname}}" maxlength="40" type="nickname" bindinput="input" placeholder="1～20个字" /><button class="action" disabled="{{saving || status !== 'ready'}}" loading="{{saving}}" bindtap="save">保存资料</button></view></view>

