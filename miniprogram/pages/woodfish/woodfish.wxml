<wxs module="feedback" src="./feedback.wxs" />
<view class="screen">
  <challenge-banner order-id="{{orderId}}" bind:leave="leave" />
  <view class="heading">电子木鱼</view>
  <view class="subtitle">跟着自己的节奏，慢慢静下来。</view>
  <view class="row section"><text>木鱼音效</text><switch color="#b67b4d" checked="{{sound}}" disabled="{{!soundReady || soundSaving}}" bindchange="sound" /></view>
  <view wx:if="{{hint}}" class="error-box" bindtap="refresh">{{hint}}</view>
  <view wx:if="{{audioHint}}" class="muted">{{audioHint}}</view>
  <view class="wood-space">
    <view id="woodfish-word" class="floating">
      <text id="woodfish-word-0" class="floating-word">健康+1</text>
      <text id="woodfish-word-1" class="floating-word">变瘦+1</text>
      <text id="woodfish-word-2" class="floating-word">变美+1</text>
      <text id="woodfish-word-3" class="floating-word">暴富+1</text>
    </view>
    <image id="woodfish-feedback" class="woodfish" src="/images/woodfish/woodfish.png" mode="aspectFit"
      data-enabled="{{ready && active}}" data-view-version="{{viewVersion}}" bindtouchstart="{{feedback.start}}"
      feedbackactive="{{active}}" change:feedbackactive="{{feedback.reset}}" />
    <view class="muted">按自己的节奏敲一敲</view>
  </view>
  <view class="section count-panel">
    <view class="muted">今日累计敲击</view><view class="count">{{count}}</view>
    <view class="muted">{{!ready ? '正在同步今日次数…' : pending ? pending + ' 次待同步' : '已同步 · 每次敲击都算数'}}</view>
  </view>
</view>


