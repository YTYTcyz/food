@import '../../styles/personal.wxss';
.wood-space { height: 560rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }.woodfish { width: 350rpx; height: 280rpx; border-radius: 48% 48% 42% 42%; background: radial-gradient(ellipse at 35% 25%, #dbae75, #ad7446 60%, #81522f); box-shadow: inset -18rpx -20rpx 0 #85552f, 0 24rpx 28rpx #be95652b; position: relative; margin-bottom: 42rpx; transition: transform .1s; }.woodfish.hit { transform: scale(.94); }.wood-line { position: absolute; inset: 30rpx; border-radius: 50%; border: 6rpx solid #916138; }.wood-mouth { position: absolute; width: 150rpx; height: 22rpx; border-radius: 18rpx; background: #513323; top: 136rpx; right: -4rpx; transform: rotate(-24deg); }.floating { height: 70rpx; opacity: 0; color: #966039; font-size: 32rpx; transition: opacity .2s, transform .2s; }.floating.show { opacity: 1; transform: translateY(-12rpx); }.count-panel { text-align: center; }.count { font-size: 86rpx; color: #8b5c3b; margin: 12rpx; }

