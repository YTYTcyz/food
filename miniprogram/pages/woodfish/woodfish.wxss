@import '../../styles/personal.wxss';
.wood-space { height: 560rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.woodfish { display: block; width: 350rpx; height: 280rpx; margin-bottom: 42rpx; transition: transform .1s; }
.woodfish.hit { transform: scale(.94); }
.floating { height: 70rpx; opacity: 0; color: #966039; font-size: 32rpx; transition: opacity .2s, transform .2s; }
.floating.show { opacity: 1; transform: translateY(-12rpx); }
.count-panel { text-align: center; }
.count { font-size: 86rpx; color: #8b5c3b; margin: 12rpx; }
