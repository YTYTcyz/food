@import '../../styles/personal.wxss';
.admin-entry { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; width: 100%; margin: 28rpx 0 0; padding: 24rpx; line-height: 1.6; font-size: 28rpx; color: #795139; background: #f5e9dd; border-radius: 24rpx; }
.admin-entry::after { border: 0; }
.admin-entry text { font-size: 22rpx; color: #9b7963; }
.profile-header { position: relative; overflow: hidden; display: flex; align-items: center; gap: 22rpx; padding: 24rpx 16rpx; margin-bottom: 28rpx; border-radius: 28rpx; }.profile-bg { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .18; }.avatar { position: relative; width: 112rpx; height: 112rpx; flex-shrink: 0; border-radius: 50%; background: #ffdfcf; color: #d16277; display: flex; align-items: center; justify-content: center; font-size: 42rpx; overflow: hidden; }.avatar-image { width: 100%; height: 100%; }.profile-copy { position: relative; flex: 1; min-width: 0; }.nickname { font-size: 38rpx; font-weight: 700; overflow-wrap: break-word; }.level { margin-top: 12rpx; font-size: 23rpx; color: #b85e62; }.achievement { background: var(--brand-gradient); color: white; border-radius: 40rpx; padding: 36rpx 30rpx; margin-bottom: 28rpx; }.stats { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr) minmax(0,1.3fr); text-align: center; gap: 16rpx; margin: 34rpx 0; font-size: 23rpx; }.number { font-size: 48rpx; font-weight: 700; margin-bottom: 10rpx; overflow-wrap: break-word; }.wallet { display: flex; align-items: center; gap: 24rpx; border-radius: 28rpx; padding: 28rpx; background: #ffffff22; }.target { font-size: 42rpx; font-weight: 700; color: #df568b; }


.wallet-copy { flex: 1; min-width: 0; }
.wallet-title { font-size: 28rpx; line-height: 1.5; opacity: .95; }
.wallet-amount { margin-top: 10rpx; line-height: 1.25; }
.wallet-action { display: flex; align-items: center; justify-content: center; flex: 0 0 228rpx; }
.wallet .withdraw { display: flex; align-items: center; justify-content: center; flex: 0 0 auto; width: 208rpx; height: 88rpx; min-height: 88rpx; margin: 0; padding: 0 28rpx; box-sizing: border-box; border: 1rpx solid #ffffffcc; border-radius: 44rpx; background: linear-gradient(180deg, #ffffff 0%, #fff3f7 100%); color: #c63f70; font-size: 30rpx; font-weight: 600; letter-spacing: 1rpx; line-height: 1; box-shadow: 0 8rpx 18rpx rgba(126, 42, 75, .14); transition: transform .15s ease, box-shadow .15s ease; }
.wallet .withdraw::after { border: 0; }
.wallet .withdraw-hover { transform: translateY(2rpx); box-shadow: 0 3rpx 8rpx rgba(126, 42, 75, .12); }
