@import '../../styles/personal.wxss';
.profile-header { position: relative; overflow: hidden; display: flex; align-items: center; gap: 22rpx; padding: 24rpx 16rpx; margin-bottom: 28rpx; border-radius: 28rpx; }.profile-bg { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .18; }.avatar { position: relative; width: 112rpx; height: 112rpx; flex-shrink: 0; border-radius: 50%; background: #ffdfcf; color: #d16277; display: flex; align-items: center; justify-content: center; font-size: 42rpx; overflow: hidden; }.avatar image { width: 100%; height: 100%; }.profile-copy { position: relative; flex: 1; min-width: 0; }.nickname { font-size: 38rpx; font-weight: 700; overflow-wrap: break-word; }.level { margin-top: 12rpx; font-size: 23rpx; color: #b85e62; }.achievement { background: var(--brand-gradient); color: white; border-radius: 40rpx; padding: 36rpx 30rpx; margin-bottom: 28rpx; }.stats { display: grid; grid-template-columns: 1fr 1fr 1.3fr; text-align: center; gap: 16rpx; margin: 34rpx 0; font-size: 23rpx; }.number { font-size: 48rpx; font-weight: 700; margin-bottom: 10rpx; overflow-wrap: break-word; }.wallet { border-radius: 28rpx; padding: 26rpx; background: #ffffff22; }.wallet-note { font-size: 22rpx; margin-top: 10rpx; opacity: .9; }.withdraw { margin: 0; flex-shrink: 0; border-radius: 40rpx; background: white; color: #db548a; font-size: 28rpx; padding: 0 24rpx; }.target { font-size: 42rpx; font-weight: 700; color: #df568b; }

