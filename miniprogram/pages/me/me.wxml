<view class="screen"><challenge-banner bind:leave="leave" /><view wx:if="{{status === 'loading'}}" class="empty">正在整理你的记录…</view><view wx:if="{{status === 'error'}}" class="error-box" bindtap="load">成果暂时没能同步 · 点击重试</view><block wx:if="{{info}}"><view class="profile-header" data-page="profile" bindtap="go"><image wx:if="{{info.background.fileID}}" class="profile-bg" src="{{info.background.fileID}}" mode="aspectFit" /><view class="avatar"><image wx:if="{{info.user.avatarFileID}}" src="{{info.user.avatarFileID}}" mode="aspectFill" /><text wx:else>我</text></view><view class="profile-copy"><view class="nickname">{{info.user.nickname}}</view><view class="level">Lv.{{info.state.level}} · {{info.nextLevel ? '距下一级还差 ' + (info.nextLevel - info.state.totalCompleted) + ' 次' : '每一次坚持都值得记住'}}</view></view><text>›</text></view><view class="achievement"><view class="section-title">我的成果</view><view class="stats"><view><view class="number">{{info.state.totalCompleted}}</view><text>成功次数</text></view><view><view class="number">{{info.checkin.count}}</view><text>连续打卡（天）</text></view><view><view class="number">{{info.state.totalCaloriesKcal}}</view><text>模拟避免 kcal</text></view></view><view class="wallet row"><view data-page="wallet" bindtap="go"><view>成就钱包 ›</view><view class="value">¥{{wallet}}</view><view class="wallet-note">模拟累计节省金额</view></view><button class="withdraw" bindtap="withdraw">去提现</button></view></view><view class="section"><view class="row"><view><view class="muted">当前体重</view><view class="value">{{currentKg}}<text wx:if="{{info.currentWeight}}" class="muted"> kg</text></view></view><view><view class="muted">目标体重</view><view class="target">{{targetKg}}<text wx:if="{{info.goal}}" class="muted"> kg</text></view></view></view><button class="action stack" data-page="weight" bindtap="go">记录今日体重</button></view><view class="section"><view class="row"><view class="section-title">体重趋势</view><view class="row"><text class="{{days === 7 ? 'link' : 'muted'}}" data-days="7" bindtap="days">7天</text><text class="{{days === 30 ? 'link' : 'muted'}}" data-days="30" bindtap="days">30天</text></view></view><weight-chart points="{{points}}" /></view><view class="section"><view class="row"><view><view class="section-title">每日打卡</view><view class="muted">{{info.checkin.today ? '今天已打卡' : info.checkin.count ? '截至昨天连续 ' + info.checkin.count + ' 天 · 今日待打卡' : '给今天留下一个小记号'}}</view></view><button class="soft-button" disabled="{{info.checkin.today}}" bindtap="checkin">{{info.checkin.today ? '已打卡' : '打卡'}}</button></view><view class="row stack"><text class="muted">连续挑战成功 {{info.successStreak.count}} 天</text><text class="link" data-page="calendar" bindtap="go">查看日历 ›</text></view></view><view class="section"><view class="section-title">本周战绩</view><view class="muted">与上周同期相比</view><view class="row list-item" wx:for="{{week}}" wx:key="key"><text>{{item.label}}</text><view><text>{{item.value}}</text><text class="muted">（{{item.difference}} {{item.unit}}）</text></view></view></view><view class="grid-two"><view class="section" data-page="cards" bindtap="go"><view class="section-title">微光拼图 ›</view><view class="muted">已集齐 {{info.state.completedCards}} 张</view></view><view class="section" data-page="badges" bindtap="go"><view class="section-title">我的徽章 ›</view><view class="muted">每一次成长的见证</view></view></view><button class="soft-button" bindtap="download">下载不忍了 App</button></block></view>

