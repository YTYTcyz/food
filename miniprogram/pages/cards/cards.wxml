<view class="screen"><view class="heading">我的微光收藏</view><view class="subtitle">7次成功，点亮一张完整拼图。</view><view wx:if="{{status === 'error'}}" class="error-box" bindtap="retry">收藏暂时没有加载 · 重试</view><view wx:if="{{!items.length}}" class="section empty"><view>{{status === 'loading' ? '正在整理收藏…' : '第一次挑战成功后，会开始你的第一张拼图。'}}</view><button wx:if="{{status === 'ready'}}" class="soft-button stack" bindtap="start">去首页开始</button></view><view class="section" wx:for="{{items}}" wx:key="_id" data-id="{{item._id}}" bindtap="open"><view class="row"><view><view class="section-title">{{item.title}}</view><view class="muted">{{item.label}}</view></view><text class="link">查看 ›</text></view></view><button wx:if="{{hasMore}}" class="soft-button" bindtap="more">查看更多</button></view>

